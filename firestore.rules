rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function projectAfter(projectId) {
      return getAfter(/databases/$(database)/documents/projects/$(projectId));
    }

    function isProjectOwner(projectId) {
      return signedIn() && project(projectId).data.ownerId == request.auth.uid;
    }

    function isProjectMember(projectId, userId) {
      return signedIn() && userId in project(projectId).data.memberIds;
    }

    match /users/{userId} {
      // The app needs to list active profiles when the owner adds a member.
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /projects/{projectId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if isProjectOwner(projectId);

      match /members/{memberId} {
        allow read: if signedIn() && request.auth.uid in project(projectId).data.memberIds;
        // getAfter supports the atomic project + owner-member creation batch.
        allow create: if signedIn() &&
          projectAfter(projectId).data.ownerId == request.auth.uid;
        allow delete: if isProjectOwner(projectId);
        allow update: if false;
      }

      match /tasks/{taskId} {
        allow read, write: if signedIn() &&
          request.auth.uid in project(projectId).data.memberIds;
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() &&
        resource.data.userId == request.auth.uid;
      // Notifications are written by authenticated project members for a
      // member of the same project after a real application event.
      allow create: if signedIn() &&
        request.resource.data.userId is string &&
        request.resource.data.projectId is string &&
        isProjectMember(
          request.resource.data.projectId,
          request.resource.data.userId
        );
    }
  }
}
